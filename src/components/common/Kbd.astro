---
interface Props {
  class?: string;
  [attribute: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<kbd
  class:list={[
    "text-label inline-flex h-5 min-w-5 items-center justify-center rounded border border-border bg-muted px-1.5 font-mono text-muted-foreground",
    className,
  ]}
  {...rest}><slot /></kbd
>
