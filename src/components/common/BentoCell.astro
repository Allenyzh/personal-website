---
interface Props {
  /** Mono label rendered as "// label". */
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div class:list={["surface flex min-w-0 flex-col gap-3 p-5 md:p-6", className]}>
  <p class="text-label font-mono text-muted-foreground">// {label}</p>
  <slot />
</div>
