---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p
  class:list={[
    "text-meta text-foreground-soft inline-flex items-center gap-2.5 rounded-full border border-border bg-card py-1 pr-3.5 pl-3 font-mono",
    className,
  ]}
>
  <span class="status-dot" aria-hidden="true"></span>
  <span><slot /></span>
</p>

<style>
  .status-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    flex: none;
    border-radius: 9999px;
    background: var(--brand);
  }

  .status-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--brand);
    animation: status-breathe 2.8s ease-out infinite;
  }

  @keyframes status-breathe {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
