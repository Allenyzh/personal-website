---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
import CopyButton from "@/components/common/CopyButton";

interface Props {
  code: string;
  lang?: ComponentProps<typeof Code>["lang"];
}

const { code, lang = "html" } = Astro.props;
---

<figure class="code-block not-prose">
  <figcaption
    class="text-label flex h-9 items-center justify-between border-b border-border pr-1 pl-4 font-mono text-muted-foreground"
  >
    <span>{lang}</span>
    <CopyButton client:visible text={code} type="Code" />
  </figcaption>
  <Code
    code={code}
    lang={lang}
    themes={{ light: "github-light", dark: "github-dark" }}
    defaultColor={false}
  />
</figure>
