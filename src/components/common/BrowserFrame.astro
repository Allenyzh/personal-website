---
interface Props {
  /** Shown in the bar: a domain or a short path. */
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-lg border border-border bg-muted",
    className,
  ]}
>
  <div
    class="text-label flex h-7 items-center gap-2 border-b border-border px-3 font-mono text-muted-foreground"
    aria-hidden="true"
  >
    <span class="size-1.5 flex-none rounded-full bg-border-strong"></span>
    <span class="min-w-0 truncate">{label}</span>
  </div>
  <slot />
</div>
