---
import { ArrowLeft, ArrowRight } from "@lucide/astro";

export interface Props {
  prevItem: { title: string; slug: string };
  nextItem: { title: string; slug: string };
  collectionType: "blog" | "projects";
}

const { prevItem, nextItem, collectionType } = Astro.props;
const card =
  "surface group flex flex-col gap-1.5 p-5 transition-colors duration-150 hover:border-border-strong";
const label =
  "text-label inline-flex items-center gap-1.5 font-mono text-muted-foreground";
---

<nav
  aria-label={collectionType === "blog" ? "More posts" : "More projects"}
  class="mt-16 grid gap-3 md:grid-cols-2"
>
  <a href={`/${collectionType}/${prevItem.slug}/`} class={card}>
    <span class={label}>
      <ArrowLeft
        class="size-3.5 transition-transform duration-150 group-hover:-translate-x-0.5"
        aria-hidden="true"
      />
      PREV
    </span>
    <span class="text-h3 text-pretty">{prevItem.title}</span>
  </a>

  <a
    href={`/${collectionType}/${nextItem.slug}/`}
    class:list={[card, "md:items-end md:text-right"]}
  >
    <span class={label}>
      NEXT
      <ArrowRight
        class="size-3.5 transition-transform duration-150 group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </span>
    <span class="text-h3 text-pretty">{nextItem.title}</span>
  </a>
</nav>
