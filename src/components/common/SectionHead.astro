---
import { ArrowRight } from "@lucide/astro";

interface Props {
  /** Two-digit position on the page, e.g. "02". */
  index: string;
  /** Kebab-case marker shown next to the index. */
  marker: string;
  title: string;
  id?: string;
  linkHref?: string;
  linkText?: string;
}

const { index, marker, title, id, linkHref, linkText } = Astro.props;
---

<header class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
  <div>
    <p class="text-label font-mono text-muted-foreground" aria-hidden="true">
      // {index} · {marker}
    </p>
    <h2 id={id} class="text-h2 mt-2 text-balance">{title}</h2>
  </div>
  {
    linkHref && linkText && (
      <a
        href={linkHref}
        class="group text-meta text-brand-ink inline-flex items-center gap-1.5 font-mono underline-offset-4 hover:underline"
      >
        {linkText}
        <ArrowRight
          class="size-3.5 transition-transform duration-150 group-hover:translate-x-0.5"
          aria-hidden="true"
        />
      </a>
    )
  }
</header>
