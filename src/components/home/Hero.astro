---
import { Picture } from "astro:assets";
import { ArrowRight, Mail } from "@lucide/astro";
import portrait from "@/assets/home/heroopt.jpeg";
import Resume from "@/assets/home/resume-Zhenhao-Yang.pdf";
import Kbd from "@/components/common/Kbd.astro";
import StatusPill from "@/components/common/StatusPill.astro";
import { Github, LinkedIn } from "@/components/common/Github";
import { buttonVariants } from "@/components/ui/button";
import {
  MY_EMAIL,
  MY_GITHUB,
  MY_LINKEDIN,
  MY_NAME,
  MY_TAGLINE,
} from "@/data/consts";
import { getCurrentExperience } from "@/lib/content";

const current = await getCurrentExperience();

const suggestion =
  "text-label inline-flex h-7 items-center rounded-md border border-border bg-card px-2.5 font-mono text-foreground-soft transition-colors duration-150 hover:border-border-strong hover:text-foreground";
const social =
  "inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors duration-150 hover:bg-muted hover:text-foreground";
---

<section class="relative isolate">
  <div class="hero-backdrop" aria-hidden="true"></div>

  <div
    class="wrap grid gap-6 pt-10 md:grid-cols-[minmax(0,1fr)_17rem] md:items-center md:gap-12 md:pt-16 lg:grid-cols-[minmax(0,1fr)_21rem]"
  >
    <div class="flex min-w-0 flex-col items-start">
      {
        /* The location is dropped on the narrowest phones, where it would wrap the pill. */
        current && (
          <StatusPill>
            Building at {current.data.company}
            {current.data.location && (
              <span class="max-[26rem]:hidden"> · {current.data.location}</span>
            )}
          </StatusPill>
        )
      }

      <h1 class="text-display mt-6 text-balance">{MY_NAME}</h1>

      <p class="text-lead mt-4 max-w-xl text-balance text-foreground-soft">
        {MY_TAGLINE}
      </p>

      {
        current && (
          <p class="text-meta mt-5 font-mono text-muted-foreground">
            {current.data.role} @{" "}
            {current.data.companyUrl ? (
              <a
                href={current.data.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-ink underline underline-offset-4"
              >
                {current.data.company}
              </a>
            ) : (
              current.data.company
            )}
          </p>
        )
      }

      <div class="mt-8 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href="#projects" class:list={[buttonVariants({ size: "lg" }), "group"]}>
          View My Work
          <ArrowRight
            class="transition-transform duration-150 group-hover:translate-x-0.5"
            aria-hidden="true"
          />
        </a>
        <a href="#contact" class={buttonVariants({ size: "lg", variant: "outline" })}>
          Get In Touch
        </a>
      </div>

      <button
        type="button"
        data-palette-open
        class="mt-8 flex h-12 w-full max-w-xl items-center gap-3 rounded-lg border border-border-strong bg-card px-4 text-left text-muted-foreground transition-colors duration-150 hover:border-brand-ink hover:text-foreground-soft"
      >
        <span class="font-mono text-brand-ink" aria-hidden="true">›</span>
        <span class="min-w-0 flex-1 truncate text-sm sm:text-base">
          Search projects, posts, actions…
        </span>
        <Kbd data-kbd-mod aria-hidden="true">⌘K</Kbd>
      </button>

      <div
        class="mt-3 flex w-full max-w-xl flex-wrap items-center justify-between gap-x-4 gap-y-3"
      >
        <ul class="flex flex-wrap gap-2" aria-label="Suggestions">
          <li>
            <a href="/projects/?category=ai" class={suggestion}>AI projects</a>
          </li>
          <li>
            <a
              href={Resume}
              target="_blank"
              rel="noopener noreferrer"
              class={suggestion}
            >
              Résumé
            </a>
          </li>
          <li>
            <button
              type="button"
              data-copy={MY_EMAIL}
              data-copy-label="Email"
              class={suggestion}
            >
              Copy email
            </button>
          </li>
        </ul>

        <ul class="-mr-2 flex items-center">
          <li>
            <a href={MY_GITHUB} class={social}>
              <Github className="size-4.5" />
              <span class="sr-only">GitHub</span>
            </a>
          </li>
          <li>
            <a href={MY_LINKEDIN} class={social}>
              <LinkedIn className="size-4.5" />
              <span class="sr-only">LinkedIn</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${MY_EMAIL}`} class={social}>
              <Mail class="size-4.5" aria-hidden="true" />
              <span class="sr-only">Email</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <Picture
      src={portrait}
      formats={["avif", "webp"]}
      width={672}
      height={840}
      fit="cover"
      position="top"
      widths={[192, 336, 672]}
      sizes="(min-width: 1024px) 336px, (min-width: 768px) 272px, 96px"
      alt={`Portrait of ${MY_NAME}`}
      loading="eager"
      fetchpriority="high"
      pictureAttributes={{ class: "order-first md:order-none" }}
      class="aspect-[4/5] w-24 rounded-xl border border-border bg-card object-cover md:w-full"
    />
  </div>
</section>

<style>
  /* Dot grid + one faint glow. This is the only place on the site it appears. */
  .hero-backdrop {
    position: absolute;
    inset: -5rem 0 auto;
    height: 34rem;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(
        40rem 22rem at 18% 0%,
        var(--brand-soft),
        transparent 70%
      ),
      radial-gradient(var(--border-strong) 1px, transparent 1.5px);
    background-size:
      100% 100%,
      22px 22px;
    mask-image: radial-gradient(
      ellipse 75% 100% at 40% 0%,
      black 30%,
      transparent 78%
    );
  }
</style>
