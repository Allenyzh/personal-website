---
import { ArrowUpRight } from "@lucide/astro";
import Resume from "@/assets/home/resume-Zhenhao-Yang.pdf";
import CopyButton from "@/components/common/CopyButton";
import Section from "@/components/common/Section.astro";
import { MY_EMAIL, MY_GITHUB, MY_LINKEDIN } from "@/data/consts";

const display = (url: string) => {
  const { hostname, pathname } = new URL(url);
  return `${hostname.replace(/^www\./, "")}${pathname.replace(/\/$/, "")}`;
};

const channels = [
  { label: "github", text: display(MY_GITHUB), href: MY_GITHUB },
  { label: "linkedin", text: display(MY_LINKEDIN), href: MY_LINKEDIN },
  { label: "résumé", text: "PDF", href: Resume },
];

const row =
  "grid grid-cols-[5.5rem_minmax(0,1fr)_auto] items-center gap-3 border-b border-border py-3.5 last:border-b-0";
const label = "text-label font-mono text-muted-foreground";
const value =
  "truncate font-mono text-sm text-foreground underline-offset-4 hover:underline";
---

<Section id="contact" labelledby="contact-title">
  <div
    class="surface grid gap-8 p-6 md:grid-cols-2 md:items-center md:gap-12 md:p-10"
  >
    <div>
      <p class="text-label font-mono text-muted-foreground" aria-hidden="true">
        // 05 · contact
      </p>
      <h2 id="contact-title" class="text-page-title mt-3 text-balance">
        Let's Work Together
      </h2>
      <p class="mt-4 max-w-md text-lg text-pretty text-foreground-soft">
        I'm always interested in new opportunities and exciting projects. Let's
        discuss how we can bring your ideas to life.
      </p>
    </div>

    <ul class="border-t border-border md:border-t-0">
      <li class={row}>
        <span class={label}>email</span>
        <a href={`mailto:${MY_EMAIL}`} class={value}>{MY_EMAIL}</a>
        <span class="-my-1 -mr-1.5 text-muted-foreground hover:text-foreground">
          <CopyButton client:visible text={MY_EMAIL} type="Email" />
        </span>
      </li>
      {
        channels.map((channel) => (
          <li class={row}>
            <span class={label}>{channel.label}</span>
            <a
              href={channel.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[value, "group col-span-2 flex items-center justify-between gap-3"]}
            >
              <span class="truncate">{channel.text}</span>
              <ArrowUpRight
                class="size-4 flex-none text-muted-foreground transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-brand-ink"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
