---
import Chip from "@/components/common/Chip.astro";
import Section from "@/components/common/Section.astro";
import SectionHead from "@/components/common/SectionHead.astro";
import { skillCategories } from "@/data/skills";
---

<Section id="skills" labelledby="skills-title">
  <SectionHead
    index="03"
    marker="stack"
    title="Skills & Technologies"
    id="skills-title"
  />

  <div class="border-t border-border">
    {
      skillCategories.map((category) => (
        <div class="grid gap-3 border-b border-border py-5 md:grid-cols-[14rem_minmax(0,1fr)] md:items-baseline md:gap-8">
          <h3 class="text-h3">{category.title}</h3>
          <ul class="flex flex-wrap gap-1.5">
            {category.skills.map((skill) => (
              <li>
                <Chip
                  href={skill.link}
                  tone={category.highlight ? "brand" : "neutral"}
                >
                  {skill.name}
                </Chip>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
