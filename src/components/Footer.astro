---
import { MY_EMAIL, MY_GITHUB, MY_LINKEDIN, MY_NAME } from "@/data/consts";

const year = new Date().getFullYear();
const link =
  "underline-offset-4 transition-colors duration-150 hover:text-foreground hover:underline";
---

<footer class="mt-24 border-t border-border md:mt-32">
  <div
    class="wrap text-label flex flex-col items-center gap-4 py-8 font-mono text-muted-foreground md:flex-row md:justify-between"
  >
    <p>&copy; {year} {MY_NAME}</p>

    <nav aria-label="Social" class="flex items-center gap-3">
      <a href={MY_GITHUB} class={link}>GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={MY_LINKEDIN} class={link}>LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${MY_EMAIL}`} class={link}>Email</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/llms.txt" class={link}>/llms.txt</a>
      <span aria-hidden="true">·</span>
      <a href="/rss.xml" class={link}>RSS</a>
      <span aria-hidden="true">·</span>
      <span title="Commit this build was made from">{__COMMIT_HASH__}</span>
    </div>
  </div>
</footer>
