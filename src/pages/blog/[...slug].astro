---
export const prerender = true;
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import JsonLd from "@/components/common/JsonLd.astro";
import { MY_NAME } from "@/data/consts";
import {
  getNeighbours,
  getSortedPosts,
  postSlug,
  type Post,
} from "@/lib/content";
import readingTime from "reading-time";

export async function getStaticPaths() {
  // Same order as the listing page, so prev/next walks the list the visitor saw.
  const posts = await getSortedPosts();
  return posts.map((post, index) => {
    const around = getNeighbours(posts, index);
    return {
      params: { slug: postSlug(post) },
      props: {
        post,
        neighbours: around && {
          prev: { title: around.prev.data.title, slug: postSlug(around.prev) },
          next: { title: around.next.data.title, slug: postSlug(around.next) },
        },
      },
    };
  });
}

type Neighbour = { title: string; slug: string };
type Props = {
  post: Post;
  neighbours?: { prev: Neighbour; next: Neighbour };
};

const { post, neighbours } = Astro.props;
const { Content, headings } = await render(post);
const site = Astro.site ?? Astro.url;
const url = new URL(`/blog/${postSlug(post)}/`, site).href;

const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.reviseDate && {
    dateModified: post.data.reviseDate.toISOString(),
  }),
  keywords: post.data.tech.join(", "),
  url,
  mainEntityOfPage: url,
  image: new URL("/og.png", site).href,
  author: { "@type": "Person", name: MY_NAME, url: site.href },
};
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  author={post.data.author}
  neighbours={neighbours}
  collectionType="blog"
  readingTime={readingTime(post.body || "").text}
  headings={headings}
  markdownHref={`/blog/${postSlug(post)}.md`}
>
  <JsonLd slot="head" data={article} />
  <Content />
</ArticleLayout>
