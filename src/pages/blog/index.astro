---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Chip from "@/components/common/Chip.astro";
import PageHead from "@/components/common/PageHead.astro";
import Row from "@/components/common/Row.astro";
import Section from "@/components/common/Section.astro";
import Stat from "@/components/common/Stat.astro";
import { getSortedPosts, postSlug, type Post } from "@/lib/content";
import { formatDate } from "@/lib/date";
import readingTime from "reading-time";

const description =
  "Thoughts, tutorials, and insights about web development, technology, and more.";

const posts = await getSortedPosts();

// A featured slot only earns its place once there is a list to stand out from.
const featuredPost =
  posts.length > 3 ? posts.find((post) => post.data.isFeatured) : undefined;
// The featured post is not repeated in the list below it.
const listedPosts = posts.filter((post) => post !== featuredPost);

const rowProps = (post: Post) => ({
  href: `/blog/${postSlug(post)}/`,
  title: post.data.title,
  description: post.data.description,
});
---

<BaseLayout title="My Blogs" specialDescription={description}>
  <PageHead path="~/blog" title="Blog" lead={description}>
    {
      posts.length > 0 && (
        <Stat slot="stats" label="posts" value={String(posts.length)} />
      )
    }
  </PageHead>

  {
    featuredPost && (
      <Section class="!mt-12" labelledby="featured-title">
        <h2 id="featured-title" class="text-h2 mb-2">
          Featured Post
        </h2>
        <Row {...rowProps(featuredPost)}>
          <time slot="meta" datetime={featuredPost.data.pubDate.toISOString()}>
            {formatDate(featuredPost.data.pubDate)}
          </time>
          <span class="mt-1 flex flex-wrap gap-1.5">
            {featuredPost.data.tech.map((tag) => (
              <Chip>{tag}</Chip>
            ))}
          </span>
          <Fragment slot="aside">
            {readingTime(featuredPost.body ?? "").text}
          </Fragment>
        </Row>
      </Section>
    )
  }

  <Section class="!mt-12" labelledby="all-title">
    <h2 id="all-title" class="text-h2 mb-2">All Posts</h2>

    {
      listedPosts.length > 0 && (
        <ul>
          {listedPosts.map((post) => (
            <li>
              <Row {...rowProps(post)}>
                <time slot="meta" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <span class="mt-1 flex flex-wrap gap-1.5">
                  {post.data.tech.map((tag) => (
                    <Chip>{tag}</Chip>
                  ))}
                </span>
                <Fragment slot="aside">
                  {readingTime(post.body ?? "").text}
                </Fragment>
              </Row>
            </li>
          ))}
        </ul>
      )
    }

    {
      posts.length === 0 && (
        <div class="py-12 text-center">
          <h3 class="text-h3 mb-2">No posts yet</h3>
          <p class="text-muted-foreground">
            Check back later for new blog posts and articles.
          </p>
        </div>
      )
    }
  </Section>
</BaseLayout>
