---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHead from "@/components/common/PageHead.astro";
import ProjectCard from "@/components/common/ProjectCard.astro";
import Section from "@/components/common/Section.astro";
import Stat from "@/components/common/Stat.astro";
import { getSortedProjects, PROJECT_CATEGORIES } from "@/lib/content";

const description =
  "A showcase of my work, including web applications, open-source projects, and technical experiments.";

const projects = await getSortedProjects();
const featuredProject = projects.find((project) => project.data.featured);

const years = projects.map((project) => project.data.pubDate.getUTCFullYear());
const span =
  years.length === 0
    ? ""
    : Math.min(...years) === Math.max(...years)
      ? String(years[0])
      : `${Math.min(...years)} — ${Math.max(...years)}`;

// Only offer filters that match at least one project.
const filters = PROJECT_CATEGORIES.filter(({ value }) =>
  projects.some((project) => project.data.projectCategories.includes(value)),
);
const filterButton =
  "text-meta inline-flex h-8 items-center rounded-full border border-border px-3.5 font-mono text-muted-foreground transition-colors duration-150 hover:border-border-strong hover:text-foreground aria-pressed:border-transparent aria-pressed:bg-brand-soft aria-pressed:text-brand-ink";
---

<BaseLayout title="My Projects" specialDescription={description}>
  <PageHead path="~/projects" title="Projects" lead={description}>
    {
      projects.length > 0 && (
        <Fragment slot="stats">
          <Stat label="projects" value={String(projects.length)} />
          <Stat label="years" value={span} />
        </Fragment>
      )
    }
  </PageHead>

  {
    featuredProject && (
      <Section class="!mt-12" labelledby="featured-title">
        <h2 id="featured-title" class="text-h2 mb-6">
          Featured Project
        </h2>
        <ProjectCard
          project={featuredProject}
          featured
          idPrefix="featured"
        />
      </Section>
    )
  }

  <Section class="!mt-16" labelledby="all-title">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
      <h2 id="all-title" class="text-h2">All Projects</h2>

      {
        filters.length > 1 && (
          <div
            role="group"
            aria-label="Filter projects by category"
            class="flex flex-wrap gap-2"
            data-project-filter
          >
            <button
              type="button"
              data-filter="all"
              aria-pressed="true"
              class={filterButton}
            >
              All
            </button>
            {filters.map((filter) => (
              <button
                type="button"
                data-filter={filter.value}
                aria-pressed="false"
                class={filterButton}
              >
                {filter.label}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <ul class="grid grid-cols-1 gap-3 md:grid-cols-2" data-project-list>
      {
        projects.map((project) => (
          <li
            class="flex min-w-0"
            data-categories={project.data.projectCategories.join(" ")}
          >
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>

    <p class="sr-only" role="status" data-project-count></p>

    {
      projects.length === 0 && (
        <div class="py-12 text-center">
          <h3 class="text-h3 mb-2">No projects yet</h3>
          <p class="text-muted-foreground">
            Check back later for new projects and developments.
          </p>
        </div>
      )
    }
  </Section>
</BaseLayout>

<script>
  // Category filter. The chosen category lives in ?category= so it can be linked to.
  const group = document.querySelector<HTMLElement>("[data-project-filter]");
  const items = document.querySelectorAll<HTMLElement>(
    "[data-project-list] > li",
  );
  const count = document.querySelector<HTMLElement>("[data-project-count]");

  if (group) {
    const buttons = Array.from(
      group.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    );
    const known = buttons.map((button) => button.dataset.filter);

    const apply = (value: string, announce: boolean) => {
      let shown = 0;
      for (const button of buttons) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.filter === value),
        );
      }
      for (const item of items) {
        const match =
          value === "all" ||
          (item.dataset.categories ?? "").split(" ").includes(value);
        item.hidden = !match;
        if (match) shown += 1;
      }
      if (announce && count) {
        count.textContent = `Showing ${shown} of ${items.length} projects`;
      }
    };

    group.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>(
        "[data-filter]",
      );
      const value = button?.dataset.filter;
      if (!value) return;

      apply(value, true);
      const url = new URL(window.location.href);
      if (value === "all") url.searchParams.delete("category");
      else url.searchParams.set("category", value);
      history.replaceState(null, "", url);
    });

    const initial = new URLSearchParams(window.location.search).get("category");
    if (initial && known.includes(initial)) apply(initial, false);
  }
</script>
