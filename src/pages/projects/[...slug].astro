---
export const prerender = true;
import { render } from "astro:content";
import ArticleLayout from "@/layouts/ArticleLayout.astro";
import {
  getNeighbours,
  getSortedProjects,
  projectSlug,
  type Project,
} from "@/lib/content";
import readingTime from "reading-time";

export async function getStaticPaths() {
  // Same order as the listing page, so prev/next walks the list the visitor saw.
  const projects = await getSortedProjects();
  return projects.map((project, index) => {
    const around = getNeighbours(projects, index);
    return {
      params: { slug: projectSlug(project) },
      props: {
        project,
        neighbours: around && {
          prev: { title: around.prev.data.title, slug: projectSlug(around.prev) },
          next: { title: around.next.data.title, slug: projectSlug(around.next) },
        },
      },
    };
  });
}

type Neighbour = { title: string; slug: string };
type Props = {
  project: Project;
  neighbours?: { prev: Neighbour; next: Neighbour };
};

const { project, neighbours } = Astro.props;
const { Content, headings } = await render(project);
---

<ArticleLayout
  title={project.data.title}
  description={project.data.description}
  pubDate={project.data.pubDate}
  dateStyle="month"
  author={project.data.author}
  tech={project.data.tech}
  neighbours={neighbours}
  collectionType="projects"
  readingTime={readingTime(project.body || "").text}
  headings={headings}
  markdownHref={`/projects/${projectSlug(project)}.md`}
>
  <Content />
</ArticleLayout>
