---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Kbd from "@/components/common/Kbd.astro";
import { buttonVariants } from "@/components/ui/button";
---

<BaseLayout>
  <div
    class="wrap flex flex-1 flex-col items-center justify-center py-24 text-center"
  >
    <p
      class="font-mono text-7xl font-medium tracking-tighter text-muted-foreground tabular-nums sm:text-9xl"
      aria-hidden="true"
    >
      4<span class="text-brand">0</span>4
    </p>
    <h1 class="text-h2 mt-6">404 - Page Not Found</h1>
    <p class="mt-3 max-w-md text-lg text-pretty text-foreground-soft">
      The page you are looking for does not exist or has been moved.
    </p>
    <a href="/" class:list={[buttonVariants({ size: "lg" }), "mt-8"]}>
      Go to Home
    </a>
    <p class="text-meta mt-6 flex items-center gap-2 font-mono text-muted-foreground">
      <button
        type="button"
        data-palette-open
        class="underline underline-offset-4 hover:text-foreground"
      >
        Search the site
      </button>
      <Kbd data-kbd-mod aria-hidden="true">⌘K</Kbd>
    </p>
  </div>
</BaseLayout>
