---
// import Footer from "../components/Footer.astro";
export const prerender = true;
import Hero from "@/components/home/Hero";
import About from "@/components/home/About";
import Projects from "@/components/home/ProjectsComponent.astro";
import Contact from "@/components/home/Contact.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Skills from "@/components/home/Skills";
import RecentBlogs from "@/components/home/RecentBlogsComponent.astro";
import { getCollection } from "astro:content";

const experiences = await getCollection("experience");
const experience = experiences[0];
const { currentJob, currentCompany, currentCompanyUrl } = experience.data;
---

<BaseLayout bodyClass="bg-[#fafaf9] text-[#0a0a0a] flex flex-col">
  <section class="flex flex-1 flex-col items-stretch">
    <Hero
      client:load
      currentJob={currentJob}
      currentCompany={currentCompany}
      currentCompanyUrl={currentCompanyUrl}
    />
    <About />
    <Skills />
    <Projects />
    <RecentBlogs />
    <Contact />
  </section>
</BaseLayout>
