---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/common/JsonLd.astro";
import Hero from "@/components/home/Hero.astro";
import AtAGlance from "@/components/home/AtAGlance.astro";
import SelectedWork from "@/components/home/SelectedWork.astro";
import Stack from "@/components/home/Stack.astro";
import Writing from "@/components/home/Writing.astro";
import Contact from "@/components/home/Contact.astro";
import {
  MY_EMAIL,
  MY_GITHUB,
  MY_LINKEDIN,
  MY_NAME,
  SITE_DESCRIPTION,
} from "@/data/consts";
import { getCurrentExperience } from "@/lib/content";

const current = await getCurrentExperience();
const site = Astro.site ?? Astro.url;

// Everything here comes from consts.ts and the experience collection.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: MY_NAME,
  url: site.href,
  image: new URL("/avatar.png", site).href,
  description: SITE_DESCRIPTION,
  email: `mailto:${MY_EMAIL}`,
  sameAs: [MY_GITHUB, MY_LINKEDIN],
  ...(current && {
    jobTitle: current.data.role,
    worksFor: {
      "@type": "Organization",
      name: current.data.company,
      ...(current.data.companyUrl && { url: current.data.companyUrl }),
    },
  }),
  ...(current?.data.location && {
    address: {
      "@type": "PostalAddress",
      addressLocality: current.data.location,
    },
  }),
};
---

<BaseLayout markdownHref="/llms.txt">
  <JsonLd slot="head" data={person} />

  <Hero />
  <AtAGlance />
  <SelectedWork />
  <Stack />
  <Writing />
  <Contact />
</BaseLayout>
