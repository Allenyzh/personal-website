---
import Nav from "@/components/navigation/Nav.astro";
import Footer from "@/components/Footer.astro";
import BaseHead from "@/layouts/BaseHead.astro";
import CommandPalette from "@/components/common/CommandPalette.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/data/consts";
import { GoogleAnalytics } from "@/components/common/GoogleAnalytic";
import { Toaster } from "@/components/ui/sonner";
// import ChristmasSnow from "@/components/common/ChristmasSnow";

interface Props {
  title?: string;
  specialDescription?: string;
  ogType?: "website" | "article";
  /** Path of this page's Markdown twin, if it has one. */
  markdownHref?: string;
}

const GA_ID = "G-P8G1Q6J8D8";
const { title, specialDescription, ogType, markdownHref } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead
      title={title ? `${title} | ${SITE_TITLE}` : SITE_TITLE}
      description={specialDescription ? specialDescription : SITE_DESCRIPTION}
      keywords="portfolio, zhenhao yang, 杨镇颢, allen yang, web developer, software engineer, full-stack developer, astro, javascript, typescript, react, nodejs, web development, programming, montreal, canada, quebec, personal website, personal portfolio, blog, projects, about me, contact"
      ogType={ogType}
      markdownHref={markdownHref}
    />

    <!-- Dark is the default. Apply a stored "light" choice before first paint. -->
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.classList.remove("dark");
        }
      } catch (e) {}
    </script>

    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>

    <!-- <ChristmasSnow client:load /> -->
    <GoogleAnalytics gtagId={GA_ID} client:only="react" />
    <Toaster client:idle />

    <Nav />

    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>

    <Footer />
    <CommandPalette />
  </body>
</html>
