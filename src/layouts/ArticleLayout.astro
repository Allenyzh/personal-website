---
import type { MarkdownHeading } from "astro";
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import Chip from "@/components/common/Chip.astro";
import CopyButton from "@/components/common/CopyButton";
import NextPrevBtnGroup from "@/components/common/NextPrevBtnGroup.astro";
import Prose from "@/components/common/Prose.astro";
import { buttonVariants } from "@/components/ui/button";

type Neighbour = { title: string; slug: string };

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  /** Projects are dated to the month; posts to the day. */
  dateStyle?: "day" | "month";
  author: string;
  tech?: string[];
  /** Omit when the collection has nothing else to link to. */
  neighbours?: { prev: Neighbour; next: Neighbour };
  collectionType: "blog" | "projects";
  readingTime?: string;
  headings?: MarkdownHeading[];
  /** Path of the Markdown version of this page. */
  markdownHref: string;
}

const {
  title,
  description,
  pubDate,
  dateStyle = "day",
  author,
  tech = [],
  neighbours,
  collectionType,
  readingTime,
  headings = [],
  markdownHref,
} = Astro.props;

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
  title={`${collectionType === "blog" ? "Blog" : "Project"} - ${title}`}
  specialDescription={description}
  ogType="article"
  markdownHref={markdownHref}
>
  <slot name="head" slot="head" />

  <article class="wrap mt-8 md:mt-12">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a
        href={`/${collectionType}`}
        class:list={[buttonVariants({ variant: "outline", size: "sm" }), "group"]}
      >
        <ArrowLeft
          class="transition-transform duration-150 group-hover:-translate-x-0.5"
          aria-hidden="true"
        />
        Back to {collectionType === "blog" ? "blogs" : "projects"}
      </a>

      <CopyButton
        client:idle
        url={markdownHref}
        type="Markdown"
        label="Copy as Markdown"
      />
    </div>

    <header class="mt-8 max-w-[44rem] md:mt-10">
      <h1 class="text-page-title text-balance">{title}</h1>

      <p
        class="text-meta mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-muted-foreground"
      >
        <FormattedDate date={pubDate} style={dateStyle} />
        <span aria-hidden="true">·</span>
        <span class="capitalize">By {author}</span>
        {
          readingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{readingTime}</span>
            </>
          )
        }
      </p>

      <p class="mt-5 text-lg text-pretty text-foreground-soft">{description}</p>

      {
        tech.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tech stack">
            {tech.map((item) => (
              <li>
                <Chip>{item}</Chip>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div
      class="mt-8 grid grid-cols-1 gap-12 border-t border-border pt-8 lg:grid-cols-[minmax(0,44rem)_minmax(0,1fr)] lg:gap-16"
    >
      <Prose>
        <slot />
      </Prose>

      {
        toc.length > 1 && (
          <aside class="hidden lg:block">
            <nav aria-labelledby="toc-title" class="sticky top-24">
              <p
                id="toc-title"
                class="text-label font-mono text-muted-foreground"
              >
                On this page
              </p>
              <ul class="mt-3 border-l border-border text-sm">
                {toc.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={[
                        "-ml-px block border-l border-transparent py-1.5 text-muted-foreground transition-colors duration-150 hover:border-border-strong hover:text-foreground",
                        heading.depth === 3 ? "pl-7" : "pl-4",
                      ]}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    {
      neighbours && (
        <NextPrevBtnGroup
          prevItem={neighbours.prev}
          nextItem={neighbours.next}
          collectionType={collectionType}
        />
      )
    }
  </article>
</BaseLayout>
